{
  "name": "wanhu-character-lab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:mesh": "tsx scripts/check-v3.ts && tsx scripts/check-body-profiles.ts",
    "check:visual": "node scripts/review-v3.mjs",
    "prepare:mixamo": "tsx scripts/prepare-mixamo.ts",
    "predev": "npm run prepare:mixamo",
    "prebuild": "npm run prepare:mixamo",
    "check:mixamo": "tsx scripts/check-mixamo.ts && tsx scripts/check-mixamo-clock.ts && tsx scripts/check-head-calibration.ts",
    "review:mixamo": "tsx scripts/review-mixamo.ts",
    "check:retired": "tsx scripts/check-fbx-only.ts",
    "check:wardrobe": "tsx scripts/check-wardrobe.ts",
    "review:wardrobe": "tsx scripts/review-wardrobe.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.55.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
